name: TDLib check

# Проверяет, что готовый TDLib XCFramework скачивается и содержит нужные
# архитектуры. Полезно после обновления TDLIB_VERSION.
on:
  workflow_dispatch:
    inputs:
      tdlib_version:
        description: Версия TDLibFramework (тег релиза Swiftgram/TDLibFramework)
        required: true
        default: 1.8.67-d1085f9c

jobs:
  check:
    runs-on: macos-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v4
      - name: Скачать
        env:
          TDLIB_VERSION: ${{ inputs.tdlib_version }}
        run: bash Scripts/fetch-tdlib.sh
      - name: Показать содержимое
        run: |
          find Vendor/TDLibFramework.xcframework -maxdepth 2
          plutil -p Vendor/TDLibFramework.xcframework/Info.plist
